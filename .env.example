# 药品与疫苗冷链温控判定系统 · 配置样例
#
# 用法：复制为 .env 并填入院内真实取值（.env 已被 .gitignore 排除，禁止入库）。
# 全部基址与凭据只从环境变量读取；缺少任何必填项时 `coldchain serve` 启动即报错退出，
# 不会静默回落到本地替身，也不会给出 localhost 默认值。

# ── 入站鉴权 ──────────────────────────────────────────────────────────────
# 记录仪 / 院内边缘网关投递温度事件时携带的 Bearer 凭据。
# 这个身份只可投递：它看不到在库批次，也看不到判定结论。
COLDCHAIN_INGEST_TOKEN=replace-with-ingest-token

# ── 角色凭据（一把令牌一个身份）──────────────────────────────────────────
# 药学部冷链管理员（经办）的凭据：触发判定、查看结论与台账、导出台账、改温区配置。
# 必填：缺它就没有人看得见判定结论，业务链断在「事件进来了、没人看得见」。
COLDCHAIN_OPERATOR_TOKEN=replace-with-operator-token

# 药学部主管（审核）的凭据：唯一能确认或否决处置结论的身份。
# 必填：缺它就没有人能把一条判定推进到「已生效」，台账永远写不回去。
COLDCHAIN_SUPERVISOR_TOKEN=replace-with-supervisor-token

# 质控 / 院感（只读调阅）的凭据：查判定依据、步骤时间线、模型调用与确认动作记录。
# 可选：不配就没有调阅通道（按最保守处理，不默认放行）。
COLDCHAIN_AUDITOR_TOKEN=replace-with-auditor-token

# ── 入站限流（可选，默认值已远高于记录仪 5 分钟一条的正常速率）───────────
# 单个点位的稳态投递速率（次 / 窗口）；超限的投递返回 E_RATE_LIMITED 并记录，不静默丢弃
COLDCHAIN_INGEST_RATE_LIMIT=60
# 速率窗口长度（秒）
COLDCHAIN_INGEST_RATE_WINDOW_SECONDS=60
# 突发额度（次）：留给断网恢复后的历史补投，避免把补数据误判成刷屏
COLDCHAIN_INGEST_RATE_BURST=300

# ── 出站：冷链台账（读时序 / 读在库批次 / 写越温记录）────────────────────
# 院内冷链台账服务基址，必须是完整绝对地址，含协议，不带末尾斜杠
COLDCHAIN_LEDGER_BASE_URL=https://ledger.internal.example-hospital.cn
COLDCHAIN_LEDGER_TOKEN=replace-with-ledger-token

# 台账单次调用时限（秒，可选，默认 15；读写两侧共用这一项）。
# 台账是院内另一个系统：慢一点不影响判定，但卡死不能拖住判定步骤。
COLDCHAIN_LEDGER_TIMEOUT_SECONDS=15

# 台账读侧缓存的有效期（秒，可选，默认 30；配成负值表示关闭缓存）。
# 取值刻意很小：在库批次是「此刻库里有什么货」，放久了就成了过期库存；
# 读失败不进缓存，避免把过期库存当现状写进台账。
COLDCHAIN_LEDGER_CACHE_TTL_SECONDS=30

# ── 出站：接种门诊 / 药事通知 ─────────────────────────────────────────────
COLDCHAIN_NOTIFY_BASE_URL=https://notify.internal.example-hospital.cn
COLDCHAIN_NOTIFY_TOKEN=replace-with-notify-token

# 通知的单次调用时限（秒，可选，默认 10）。
COLDCHAIN_NOTIFY_TIMEOUT_SECONDS=10

# 通知渠道（可选，默认 coldchain_deviation「冷链温控越温」）。
# 院内通知系统的渠道名各家不同，按本院约定覆盖即可。
COLDCHAIN_NOTIFY_CHANNEL=coldchain_deviation

# 通知对象（可选，默认 vaccination_clinic 预防接种门诊）。
# 多个点位分属不同门诊时，按点位配置覆盖更合适——本轮先给全局默认。
COLDCHAIN_NOTIFY_AUDIENCE=vaccination_clinic

# ── 出站写回的退避重试 ──────────────────────────────────────────────────
# 台账写不进去、门诊通知发不出时的额外重试次数（可选，默认 2；0 表示不重试）。
# 连首次共发起 1+N 次调用。台账短时抖动值得再敲一次门，
# 但主管点完确认要的是当场回执，不能把一次确认拖成几分钟的等待。
COLDCHAIN_WRITEBACK_MAX_RETRIES=2

# 首次退避的等待秒数（可选，默认 1）。之后按指数增长并封顶在 8 秒。
# 重试用尽仍未落成的越温会挂到「待补偿」，等补发；不会静默丢弃。
COLDCHAIN_WRITEBACK_BACKOFF_SECONDS=1

# ── 模型网关（OpenAI-compatible）─────────────────────────────────────────
# 院内自建推理端点或合规云端点；业务层只依赖单一 ModelGateway，不绑定厂商
MODEL_BASE_URL=https://llm.internal.example-hospital.cn/v1
MODEL_API_KEY=replace-with-model-api-key
MODEL_NAME=replace-with-deployed-model-name
MODEL_TIMEOUT_SECONDS=30

# 模型单价表（可选）：每 token 单价的 JSON 文件，用来估算模型调用成本。
# 不配就把成本记成 unknown（「本服务不知道单价」），而不是记 0（「这次调用不花钱」）。
# 格式：{"模型名": {"input_cost_per_token": 0.0000012, "output_cost_per_token": 0.0000024, "currency": "CNY"}}
# 输入输出两项成本都为 0 的条目会被当作未填的占位行剔除，不进成本核算。
MODEL_PRICE_TABLE=./data/model_prices.json

# ── 本地存储与归档 ────────────────────────────────────────────────────────
DATABASE_PATH=./data/coldchain.db
ARCHIVE_DIR=./data/archive
